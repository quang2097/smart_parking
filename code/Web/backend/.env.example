PORT=3000
DATABASE_URL=postgresql://parking:parking@localhost:5433/smart_parking
APP_URL=http://localhost:5173
NODE_ENV=development
# Development without SMTP prints email OTP codes to the server console only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Smart Traffic <no-reply@example.com>
SEED_EMAIL=admin@example.com
SEED_NAME=Quản trị viên
SEED_ROLE=admin
SEED_PASSWORD=
# Optional camera catalog (server-local file). Without it, development shows labelled demo frames.
CAMERA_CATALOG_FILE=
CAMERA_ALLOWED_ORIGINS=
# Only needed if a configured camera names this variable via authorizationEnv.
MY_CAMERA_AUTHORIZATION=
