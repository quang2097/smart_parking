{
  "name": "smart-traffic-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Traffic control and monitoring desktop client",
  "author": "Smart Traffic",
  "main": "src/main.cjs",
  "scripts": {
    "build:ui": "node ../scripts/build-clients.mjs desktop",
    "start": "npm run build:ui && electron .",
    "pack": "npm run build:ui && electron-builder --dir",
    "dist": "npm run build:ui && electron-builder --win nsis",
    "test": "node --test src/*.test.cjs",
    "test:smoke": "npm run build:ui && electron scripts/smoke.cjs --smoke-test",
    "test:use-cases": "npm run test:smoke",
    "test:camera-web": "npm --prefix ../Web/frontend run build && electron scripts/camera-web-smoke.cjs",
    "test:camera-native": "npm run build:ui && electron scripts/camera-web-smoke.cjs --native-camera-test --smoke-test"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.smarttraffic.desktop",
    "productName": "Smart Traffic",
    "directories": { "output": "release" },
    "files": ["src/**/*.cjs", "!src/**/*.test.cjs", "ui/**/*", "package.json"],
    "win": { "target": "nsis", "icon": "assets/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
